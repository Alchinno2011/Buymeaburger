name: dockercompose6306717598567781746
services:
  GroceryListDB:
    container_name: GroceryListDB
    environment:
      API_IN_HTTP: "7000"
      API_IN_HTTPS: "7001"
      API_OUT_HTTP: "7000"
      API_OUT_HTTPS: "7001"
      DATABASE_IN: "5432"
      DATABASE_OUT: "5432"
      DB_DATABASE: GroceryListDB
      DB_HOST: grocerylistdb
      DB_PASSWORD: AlChinno
      DB_PORT: "5432"
      DB_USER: SimplySiteUser
      FRONTEND_IN_HTTP: "80"
      FRONTEND_IN_HTTPS: "443"
      FRONTEND_OUT_HTTP: "80"
      FRONTEND_OUT_HTTPS: "443"
      HOST: localhost
      HTTPS_CERT_PASS: AlChinno2011!
      HTTPS_CERT_PATH: /https/simplysite.pfx
      POSTGRES_DB: GroceryListDB
      POSTGRES_PASSWORD: AlChinno
      POSTGRES_USER: SimplySiteUser
    expose:
      - "5432"
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U SimplySiteUser -d GroceryListDB
      timeout: 5s
      interval: 5s
      retries: 5
    image: postgres:14-alpine
    networks:
      Database: null
    platform: linux/amd64
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Konstantins pc\source\repos\shoppingList_backend\.containers\PetersPizza\Database
        target: /var/lib/postgresql/data
        bind:
          create_host_path: true
  shoppinglist_backend:
    build:
      context: C:\Users\Konstantins pc\source\repos\shoppingList_backend
      dockerfile: shoppingList_backend/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: shoppingList_backend
      target: base
    container_name: Api
    depends_on:
      GroceryListDB:
        condition: service_healthy
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      API_IN_HTTP: "7000"
      API_IN_HTTPS: "7001"
      API_OUT_HTTP: "7000"
      API_OUT_HTTPS: "7001"
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "7000"
      ASPNETCORE_HTTPS_PORTS: "7001"
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      DATABASE_IN: "5432"
      DATABASE_OUT: "5432"
      DB_DATABASE: GroceryListDB
      DB_HOST: grocerylistdb
      DB_PASSWORD: AlChinno
      DB_PORT: "5432"
      DB_USER: SimplySiteUser
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      FRONTEND_IN_HTTP: "80"
      FRONTEND_IN_HTTPS: "443"
      FRONTEND_OUT_HTTP: "80"
      FRONTEND_OUT_HTTPS: "443"
      HOST: localhost
      HTTPS_CERT_PASS: AlChinno2011!
      HTTPS_CERT_PATH: /https/simplysite.pfx
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: shoppinglistbackend:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net9.0/shoppingList_backend.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      Database: null
    ports:
      - mode: ingress
        target: 7001
        published: "7001"
        protocol: tcp
      - mode: ingress
        target: 7000
        published: "7000"
        protocol: tcp
      - mode: ingress
        target: 7000
        protocol: tcp
      - mode: ingress
        target: 7001
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: C:\Users\Konstantins pc\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\source\repos\shoppingList_backend\shoppingList_backend
        target: /app
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\source\repos\shoppingList_backend
        target: /src
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\vsdbg\vs2017u5
        target: /remote_debugger
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /.nuget/fallbackpackages
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net6.0
        target: /VSTools
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\2022\Community\Common7\IDE\CommonExtensions\Microsoft\HotReload
        target: /HotReloadAgent
        read_only: true
        bind:
          create_host_path: true
