name: dockercompose6306717598567781746
services:
  GroceryListDB:
    container_name: GroceryListDB
    environment:
      API_IN_HTTP: "5000"
      API_IN_HTTPS: "5001"
      API_OUT_HTTP: "5000"
      API_OUT_HTTPS: "5001"
      DATABASE_IN: "5432"
      DATABASE_OUT: "5432"
      DB_DATABASE: GroceryListDB
      DB_HOST: grocerylistdb
      DB_PASSWORD: AlChinno
      DB_PORT: "5432"
      DB_USER: SimplySiteUser
      FRONTEND_IN_HTTP: "80"
      FRONTEND_IN_HTTPS: "443"
      FRONTEND_OUT_HTTP: "80"
      FRONTEND_OUT_HTTPS: "443"
      HOST: localhost
      HTTPS_CERT_PASS: AlChinno2011!
      HTTPS_CERT_PATH: /https/simplysite.pfx
      POSTGRES_DB: GroceryListDB
      POSTGRES_PASSWORD: AlChinno
      POSTGRES_USER: SimplySiteUser
    expose:
      - "5432"
    healthcheck:
      test:
        - CMD-SHELL
        - pg_isready -U SimplySiteUser -d GroceryListDB
      timeout: 5s
      interval: 5s
      retries: 5
    image: postgres:14-alpine
    networks:
      Database: null
    platform: linux/amd64
    ports:
      - mode: ingress
        target: 5432
        published: "5432"
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Konstantins pc\source\repos\shoppingList_backend\.containers\PetersPizza\Database
        target: /var/lib/postgresql/data
        bind:
          create_host_path: true
  shoppinglist_backend:
    build:
      context: C:\Users\Konstantins pc\source\repos\shoppingList_backend
      dockerfile: shoppingList_backend/Dockerfile
    container_name: Api
    depends_on:
      GroceryListDB:
        condition: service_healthy
        required: true
    environment:
      API_IN_HTTP: "5000"
      API_IN_HTTPS: "5001"
      API_OUT_HTTP: "5000"
      API_OUT_HTTPS: "5001"
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      DATABASE_IN: "5432"
      DATABASE_OUT: "5432"
      DB_DATABASE: GroceryListDB
      DB_HOST: grocerylistdb
      DB_PASSWORD: AlChinno
      DB_PORT: "5432"
      DB_USER: SimplySiteUser
      FRONTEND_IN_HTTP: "80"
      FRONTEND_IN_HTTPS: "443"
      FRONTEND_OUT_HTTP: "80"
      FRONTEND_OUT_HTTPS: "443"
      HOST: localhost
      HTTPS_CERT_PASS: AlChinno2011!
      HTTPS_CERT_PATH: /https/simplysite.pfx
    image: shoppinglistbackend
    networks:
      Database: null
    ports:
      - mode: ingress
        target: 5001
        published: "5001"
        protocol: tcp
      - mode: ingress
        target: 5000
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\Konstantins pc\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\Konstantins pc\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
networks:
  Database:
    name: dockercompose6306717598567781746_Database